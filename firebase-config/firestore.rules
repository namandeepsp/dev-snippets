rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------ Helpers ------------------ */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    /* ------------------ Snippets ------------------ */
    match /snippets/{snippetId} {

      /* ---------- Create ---------- */
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.resource.data.updatedAt
        && request.resource.data.likesCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.isDeleted == false
        && request.resource.data.visibility in ["private", "public", "shared"];

      /* ---------- Read ---------- */
      allow read: if
        (resource.data.visibility == "public" && resource.data.isDeleted == false)
        || isOwner(resource)
        || (
          resource.data.visibility == "shared"
          && isSignedIn()
          && request.auth.uid in resource.data.sharedWith
        );

      /* ---------- Update ---------- */
      allow update: if isOwner(resource)
        // cannot update deleted snippets
        && resource.data.isDeleted == false

        // immutable fields
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt

        // prevent client-side likes / views tampering
        && request.resource.data.likesCount == resource.data.likesCount
        && request.resource.data.viewsCount == resource.data.viewsCount

        // prevent undelete (false -> true allowed, true -> false blocked)
        && (
          resource.data.isDeleted == false
          || request.resource.data.isDeleted == true
        )

        // shared snippets must define sharedWith
        && (
          request.resource.data.visibility != "shared"
          || (
            request.resource.data.sharedWith is list
            && request.resource.data.sharedWith.size() > 0
          )
        );

      /* ---------- Delete (disabled, soft delete only) ---------- */
      allow delete: if false;
    }

    /* ------------------ Users ------------------ */
    match /users/{userId} {

      // Anyone can read public user profiles
      allow read: if true;

      // Only the user can create their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Only the user can update their own profile
      allow update: if isSignedIn() && request.auth.uid == userId;

      // Prevent deletion
      allow delete: if false;
    }
  }
}
