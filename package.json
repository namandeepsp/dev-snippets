{
  "name": "dev-snippets",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "_comment": "─── Core ───",
    "dev": "pnpm code:fix && next dev",
    "build": "pnpm code:fix && next build",
    "build:prod": "pnpm lint && pnpm typecheck && NODE_ENV=production next build",
    "build:prod:with-integration": "pnpm lint && pnpm typecheck && pnpm test && set -a; . ./.env.prod; set +a; pnpm test:formatter && NODE_ENV=production next build",
    "start": "next start",
    "_comment2": "─── Code Quality ───",
    "lint": "biome check src scripts",
    "format": "biome format ./src ./scripts --write",
    "organize": "biome check ./src ./scripts --write",
    "_comment3": "─── Combined Step (used by dev/build) ───",
    "code:fix": "pnpm format && pnpm organize",
    "_comment4": "─── Type Safety ───",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "_comment5": "─── Tests ───",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:firebase": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run scripts/tests/auth.test.ts scripts/tests/database.test.ts scripts/tests/snippet.test.ts scripts/tests/snippet-versioning.test.ts scripts/tests/user.test.ts",
    "test:firebase:all": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run scripts/tests/all.test.ts",
    "test:auth": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run auth",
    "test:snippet": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run snippet",
    "test:user": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run user",
    "test:database": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run database",
    "test:all": "set -a; . ./.env.test; set +a; RUN_FIREBASE_TESTS=true vitest run all",
    "test:formatter": "set -a; . ./.env.test; set +a; vitest run formatter",
    "test:formatter:integration": "set -a; . ./.env.test; set +a; RUN_FORMATTER_INTEGRATION_TESTS=true vitest run formatter.integration",
    "test:formatter:contract": "set -a; . ./.env.test; set +a; vitest run formatter.contract",
    "_comment5c": "─── Complete Pipeline ───",
    "pipeline": "pnpm lint && pnpm typecheck && pnpm test",
    "pipeline:prod": "pnpm lint && pnpm typecheck && pnpm test && set -a; . ./.env.prod; set +a; pnpm test:formatter",
    "tools:seed:users": "set -a; . ./.env.local; set +a; tsx scripts/features/seed-users.script.ts",
    "tools:seed:users:prod": "set -a; . ./.env.prod; set +a; ALLOW_NON_DEV_SCRIPTS=true tsx scripts/features/seed-users.script.ts",
    "tools:seed": "set -a; . ./.env.local; set +a; tsx scripts/features/seed.script.ts",
    "tools:seed:prod": "set -a; . ./.env.prod; set +a; ALLOW_NON_DEV_SCRIPTS=true tsx scripts/features/seed.script.ts",
    "tools:clear": "set -a; . ./.env.local; set +a; tsx scripts/features/clear.script.ts",
    "tools:clear:prod": "set -a; . ./.env.prod; set +a; ALLOW_NON_DEV_SCRIPTS=true tsx scripts/features/clear.script.ts",
    "tools:auth": "set -a; . ./.env.local; set +a; tsx scripts/features/auth.script.ts",
    "tools:user": "set -a; . ./.env.local; set +a; tsx scripts/features/user.script.ts",
    "tools:snippet": "set -a; . ./.env.local; set +a; tsx scripts/features/snippet.script.ts",
    "tools:snippet:prod": "set -a; . ./.env.prod; set +a; ALLOW_NON_DEV_SCRIPTS=true tsx scripts/features/snippet.script.ts",
    "test:snippet:prod": "set -a; . ./.env.prod; set +a; ALLOW_NON_DEV_SCRIPTS=true vitest run snippet --mode prod",
    "_comment7": "─── Firebase ───",
    "firebase:login": "firebase login",
    "firebase:list": "firebase projects:list",
    "firebase:init": "firebase init firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:firestore": "firebase deploy --only firestore",
    "firebase:deploy:dev": "firebase use dev && pnpm firebase:deploy:firestore",
    "firebase:deploy:prod": "firebase use prod && pnpm firebase:deploy:firestore"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.15",
    "@uiw/codemirror-theme-github": "^4.25.5",
    "@uiw/codemirror-theme-sublime": "^4.25.5",
    "@uiw/codemirror-theme-vscode": "^4.25.5",
    "@uiw/react-codemirror": "^4.25.5",
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "highlight.js": "^11.11.0",
    "jszip": "^3.10.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-tooltip": "^5.30.0",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.7.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.18",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}