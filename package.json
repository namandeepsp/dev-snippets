{
  "name": "dev-snippets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "_comment": "─── Core ───",
    "dev": "pnpm code:fix && next dev",
    "build": "pnpm code:fix && next build",
    "build:prod": "pnpm code:fix && NODE_ENV=production next build",
    "start": "next start",
    "_comment2": "─── Code Quality ───",
    "lint": "biome check src",
    "format": "biome format ./src --write",
    "organize": "biome check ./src --write",
    "_comment3": "─── Combined Step (used by dev/build) ───",
    "code:fix": "pnpm format && pnpm organize",
    "_comment4": "─── Type Safety ───",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "_comment5": "─── Tests ───",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:auth": "vitest run auth",
    "test:snippet": "vitest run snippet",
    "test:user": "vitest run user",
    "test:database": "vitest run database",
    "test:all": "vitest run all",
    "_comment6": "─── Tools ───",
    "tools:seed": "tsx scripts/features/seed.script.ts",
    "tools:clear": "tsx scripts/features/clear.script.ts",
    "tools:auth": "tsx scripts/features/auth.script.ts",
    "tools:user": "tsx scripts/features/user.script.ts",
    "tools:snippet": "tsx scripts/features/snippet.script.ts",
    "_comment7": "─── Firebase ───",
    "firebase:login": "firebase login",
    "firebase:list": "firebase projects:list",
    "firebase:init": "firebase init firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:firestore": "firebase deploy --only firestore",
    "firebase:deploy:dev": "firebase use dev && pnpm firebase:deploy:firestore",
    "firebase:deploy:prod": "firebase use prod && pnpm firebase:deploy:firestore"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.7.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.18",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
